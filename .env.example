# ===================================================================
# work2api 配置示例
# -------------------------------------------------------------------
# 用法：复制本文件为同目录下的 .env，取消需要的行的注释（去掉行首 #）后按需改值。
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / macOS:       cp .env.example .env
#
# 优先级：命令行参数 > 系统环境变量 > .env。已存在的环境变量不会被 .env 覆盖。
# 位置：.env 需放在“启动 work2api 时的工作目录”下（通常即 exe 所在目录）。
# 默认全部注释掉 —— 保持注释即使用下方标注的默认值，不改变任何行为。
# 提示：填了非法值（如把端口写成非数字）不会崩，启动时会在终端打印“⚠ 配置警告”
#       并回退默认值。含 ADMIN_TOKEN 等敏感信息，已被 .gitignore 忽略，切勿提交。
# ===================================================================


# ---- 常用启动配置（其余通常无需修改）--------------------------------

# 本地使用无需填写；公网 HTTPS 部署只需设置足够随机的管理令牌。
# 填写后自动允许外部 Host，并为公网域名使用 Secure Cookie。
# 本机/SSH 隧道的真实回环 HTTP 访问仍可登录；不自动修改监听地址。
#ADMIN_TOKEN=

# 监听地址。默认仅本机 127.0.0.1。要让局域网/其它设备访问改为 0.0.0.0，
# 对外服务必须设置 ADMIN_TOKEN；未设置时管理接口仅允许真实回环连接。
#HOST=127.0.0.1

# 监听端口。默认 8787。
# 避让规则：仅当端口保持默认 8787 且被占用时，启动会自动向后避让最多 3 次
# （8788→8789→8790）并在终端打印提示；一旦你显式设置 PORT 或 -port，则不再
# 自动避让，被占用时直接报错（尊重你的显式配置）。
#PORT=8787

# ---- 进阶配置（保留注释即自动使用合理默认值）------------------------

# 外部 Host 策略默认根据 ADMIN_TOKEN 自动选择：有令牌=true，无令牌=false。
# 只有需要覆盖自动策略时才填写。例如私人本机服务可强制 false。
#ALLOW_EXTERNAL_HOST=true

# 请求体硬上限（含图片/工具历史），默认 256 MiB；必须大于 0。
# 登录接口单独限制为 8 KiB。请求体读取最多 30 秒，不限制之后的 SSE 时长。
#MAX_REQUEST_BYTES=268435456
# 模型调用不设本地执行并发、队列、用户/Key/账号名额或每日额度上限。
# 旧 MAX_CONCURRENT_REQUESTS / MODEL_* 并发排队配置不再限制模型调用。
#ADMIN_CONCURRENCY=8
#HEAVY_ADMIN_CONCURRENCY=2
#QUERY_CONCURRENCY=4
#BODY_READ_CONCURRENCY=4
# BODY_READ_CONCURRENCY 仅用于非模型请求；模型请求直接读取，仍检查总字节预算。
# 可选原始请求体总缓冲预算，默认0（不附加全局额度），仍检查每次请求的256MiB上限。
#REQUEST_BODY_BUDGET=0
# 非流式上游响应读取/聚合上限，按sub2api最新源码默认128MiB；SSE不累计封顶。
#MAX_RESPONSE_BYTES=134217728
# SSE单行与单事件解析保护40MiB，多行data也累计检查；正常流式总输出不累计封顶。
# JSON结构数量和深度保护独立于执行并发，默认100万结构符号/512层。
# 长文本、图片和工具参数字符串内部标点不计数；0可显式关闭相应保护。
#MAX_JSON_ITEMS=1000000
#MAX_JSON_DEPTH=512


# ---- 鉴权 ----------------------------------------------------------

# ADMIN_TOKEN 位于文件开头；推理 API 使用管理台创建的独立 API Key。
# 留空时管理接口仍仅允许真实回环连接。

# 根据 ADMIN_TOKEN/外部 Host 策略自动启用公网 Secure Cookie。
# 自动模式保留真实回环 HTTP 登录；直连 TLS 始终 Secure。
# 显式 true 强制包括回环在内使用 Secure；显式 false 仅用于可信局域网 HTTP。
# 公网保持自动默认并使用 HTTPS；不信任 X-Forwarded-Proto。
#ADMIN_COOKIE_SECURE=true

# Cloudflare Tunnel 公网 HTTPS 门户：应用只需非空 ADMIN_TOKEN；
# 隧道 HTTP Host Header 填外部域名，移除旧的 false 安全策略覆盖项。
# 同主机回源可用 http://127.0.0.1:8787；跨容器请使用私有网络服务名。
# 完整配置见 docs/deployment.md，502 / 来源拒绝排查见 docs/troubleshooting.md。


# ---- 数据与日志 ----------------------------------------------------

# 数据目录（数据库、附件、密钥等）。相对路径相对于工作目录。默认 data。
#DATA_DIR=data

# SQLite 数据库文件路径。留空 = <DATA_DIR>/work2api.db。
#DB_PATH=

# 日志级别：DEBUG / INFO / WARN / ERROR。默认 INFO。
#LOG_LEVEL=INFO

# 是否同时写日志文件。1=写（默认），0=只输出到终端。
#LOG_TO_FILE=1


# ---- 请求脱敏 / 限流 ----------------------------------------------

# 旧 DESENSITIZE 配置已停用：网关保留 system/developer 的完整语义，
# 不再摘要替换技能/Agent/MCP 指令或插入零宽字符。旧环境变量会被忽略。
# 日志隐私应单独配置；渠道拒绝按既有授权范围进行账号故障切换。

# WorkBuddy 国内/国际账号遇到结构化 400/403 + 11128 且无输出时，优先尝试固定模板兼容。
# 仅把已验证的首行 Claude Code 固定身份声明改为通用编码助手声明，
# 后续技能/Agent/MCP/项目指令全部保留。重试重新校验权限并计入总 5 次尝试。
# 普通内容拒绝、未知模板、国际账号和已开始的响应不启用此回退。
#CHANNEL_IDENTITY_COMPAT=true
# 11128 拒绝时，可进一步移除已验证的 CC 归因头；技能/工具/权限指令保留。
# 关闭 CHANNEL_IDENTITY_COMPAT 会同时关闭此项；两级兼容合计最多 2 次、总尝试最多 5 次。
# 同一请求换号保留已启用的兼容，不重发已被拒绝的原文；未知模板不做整段清洗。
#CHANNEL_METADATA_COMPAT=true

# 消息压缩（/v1/responses 专用）：把 Codex CLI 的 agentic 请求（海量运行时提示/
# 工具 schema/长历史）投影成最小语义上下文，显著省 token 并降低触发上游内容审核
# 的概率。有损压缩：早期历史变摘要，需要精确旧细节时模型会重跑工具。默认 false。
#OPTIMIZE_CONTEXT=false

# 不额外施加每账号请求间隔；上游实际限流仍按 Retry-After 等信息退避。


# ---- 定时任务（整点小时用 0–23；多个用英文逗号分隔）----------------
# 这些也可在 WebUI「设置」页在线修改，一般无需在此配置。

# 自动签到时间。默认 9,21。
#CHECKIN_HOURS=9,21

# 账号额度刷新间隔（分钟）。默认 30。
#CREDIT_REFRESH_MIN=30

# 模型目录刷新时间（小时）。默认 6。
#MODEL_REFRESH_HOUR=6

# Token 保活时间（小时）。默认 22。
#KEEPALIVE_HOUR=22


# ---- 用量记录清理 --------------------------------------------------

# 用量日志保留天数。默认 90。<=0 视为不按天清理（不会清空）。
#USAGE_RETENTION_DAYS=90

# 用量日志总行数上限。默认 100000（0=不限）。防止高频调用撑爆数据库。
#USAGE_MAX_ROWS=100000

# 行数上限的检查间隔（分钟）。默认 30。
#USAGE_CHECK_INTERVAL_MIN=30

# 单条 input/output/reasoning 内容的最大字节数。默认 32768（32KB，0=不限）。
# 主要用于截断 base64 图片这类超大 payload。
#USAGE_CONTENT_MAX_BYTES=32768

# ---- 用户门户调用策略 ----
# 门户调用不限制每日次数或 Tokens，不配置用户并发名额。

# 小内存服务器可设置 Go 软内存目标，仍须配合进程硬上限和真实负载验证。
# 须在进程启动前配置到 systemd / shell 环境，仅写本 .env 不会应用 Go 内存目标。
#GOMEMLIMIT=192MiB

# 完整备份默认关闭，在管理台设置中启用每日任务（最近 7 份）。
# 如需同时恢复服务器反代/证书/systemd 配置，用 JSON 数组指定实际文件路径。
# 显式指定路径不存在时备份失败；不支持符号链接；归档含敏感配置。
#BACKUP_EXTRA_PATHS=["/etc/work2api/service.env","/etc/nginx/conf.d/work2api.conf"]
# 外部环境文件的备份路径；不是 .env 加载选项。
#ENV_FILE=/etc/work2api/service.env
# Qoder 自动签到/额度维护为管理台独立开关，默认关闭，无额外常驻调度进程。

# 日志正文存储策略，仅影响历史查看/正文搜索，不限制模型输入或输出。
# 0 表示关闭对应的正文清理规则；用量、计费和性能仍由原记录保留规则管理。
USAGE_CONTENT_RETENTION_DAYS=7
USAGE_CONTENT_BUDGET_BYTES=536870912
